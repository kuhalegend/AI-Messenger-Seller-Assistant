{
  "manifest_version": 3,
  "name": "AI Messenger Seller Assistant",
  "version": "0.2.0",
  "description": "Seller assistant bridge for personal Facebook Messenger. MVP starts in detection-only mode.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Messenger Seller Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "content-messenger.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "AI Messenger"
}
